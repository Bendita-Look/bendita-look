    "module-alias": "^2.3.4",
    "nodemailer": "^10.1.1"
  },
  "devDependencies": {
    "@cap-js/cds-typer": "^0.38.0",
    "@cap-js/cds-types": "^0.15.0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "@types/adm-zip": "^0.5.8",
